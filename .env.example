# ─────────────────────────────────────────────────────────────────
# MyTurfy — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to GitHub — it's in .gitignore.
# ─────────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5000

# MongoDB Atlas — replace with your real connection string
# Get it from: Atlas dashboard → Connect → Drivers → Node.js
MONGO_URI=mongodb://localhost:27017/myturfy

# JWT — pick any long random string, keep it secret
JWT_SECRET=your-jwt-secret-here-change-me
JWT_EXPIRES_IN=7d

# Google Sign-In — get from console.cloud.google.com → APIs & Services →
# Credentials → Create OAuth Client ID (type: Web application)
# Leave blank to skip — the app runs fine without it, "Sign in with
# Google" buttons just won't work until this is set.
GOOGLE_CLIENT_ID=

# Razorpay — get from razorpay.com/dashboard → Settings → API Keys
# Leave blank for now — the server runs in test mode without them
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudinary — get from cloudinary.com/console
# Leave blank for now — image uploads are skipped without them
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email — use a Gmail account + App Password
# Guide: myaccount.google.com → Security → 2FA → App passwords
# Leave blank for now — emails are logged to console without them
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=MyTurfy <no-reply@myturfy.com>

# Platform commission taken from each booking (default 10%)
PLATFORM_COMMISSION_PCT=10

# Admin credentials (used for admin panel login)
ADMIN_EMAIL=admin@myturfy.com
ADMIN_NAME=admin
ADMIN_PASS=change-me-in-production
ADMIN_FATHER=change-me
ADMIN_MOTHER=change-me
